#
# Client-side (Vite) environment variables
# Copy to `.env` (or `.env.local`) and fill in values.
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production: canonical public URL (no trailing slash). Must match Supabase → Authentication →
# URL Configuration (Site URL + Redirect URLs) or confirmation / reset emails may not send or links may fail.
# Example: https://diabeaters.vercel.app
VITE_PUBLIC_SITE_URL=

# Optional
VITE_APP_ENV=development
# Production builds: Feed + community DMs only if this is exactly `true` (set in Vercel env).
# VITE_FEATURE_COMMUNITY=true
#
# Diabeaters Coach (Edge Function `ai_coach` + OpenAI). Client UI is **on by default**.
# Set to `false` only if you need to hide `/coach` and the Tools tile from a build.
# VITE_FEATURE_AI_COACH=false
VITE_SENTRY_DSN=

# Public support inbox (Account deletion mailto, Support page, Privacy policy).
# Defaults to info@diabeaters.world in code when unset; use this line to pin the inbox for this clone.
VITE_SUPPORT_EMAIL=info@diabeaters.world

# Optional: Supabase Auth CAPTCHA (Cloudflare Turnstile).
# If you enable CAPTCHA for signups in Supabase, set this to your Turnstile site key
# so the signup form can submit a `captchaToken`.
VITE_TURNSTILE_SITE_KEY=

# --- Server (Node / deployment env, not bundled into Vite) ---
# OPENAI_API_KEY=
# Set to "true" only after legal/DPIA approval — enables POST /api/activity/advice (educational LLM text).
# ENABLE_ACTIVITY_ADVICE=false
#
# --- Supabase Edge Function `ai_coach` (set in Supabase Dashboard → Edge Functions → Secrets, not in Vite) ---
# ENABLE_AI_COACH=false
# OPENAI_API_KEY=
# AI_COACH_MAX_PER_DAY=50
# Optional: live diabetes headlines (otherwise curated static articles are used).
# NEWS_API_KEY=
