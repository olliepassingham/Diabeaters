#
# Client-side (Vite) environment variables
# Copy to `.env` (or `.env.local`) and fill in values.
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional
VITE_APP_ENV=development
# Production builds: Feed + community DMs only if this is exactly `true` (set in Vercel env).
# VITE_FEATURE_COMMUNITY=true
VITE_SENTRY_DSN=

# Support email (mailto on Account → Request account deletion, Support page). Set for production so deletion requests open the user’s mail app.
VITE_SUPPORT_EMAIL=
