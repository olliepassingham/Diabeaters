#
# Client-side (Vite) environment variables
# Copy to `.env` (or `.env.local`) and fill in values.
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional
VITE_APP_ENV=development
# Production builds: Feed + community DMs only if this is exactly `true` (set in Vercel env).
# VITE_FEATURE_COMMUNITY=true
VITE_SENTRY_DSN=

# Support email (mailto on Account → Request account deletion, Support page, Privacy policy). Set for production so deletion requests open the user’s mail app.
VITE_SUPPORT_EMAIL=

# --- Server (Node / deployment env, not bundled into Vite) ---
# OPENAI_API_KEY=
# Set to "true" only after legal/DPIA approval — enables POST /api/activity/advice (educational LLM text).
# ENABLE_ACTIVITY_ADVICE=false
# Optional: live diabetes headlines (otherwise curated static articles are used).
# NEWS_API_KEY=
